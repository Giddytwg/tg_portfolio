---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection, render } from "astro:content";
import { postUrl, sortPostsNewestFirst, postDateLabel, postMinutes, postNumber, postCoverVariant, relatedPosts } from "../../lib/content";
import { SITE_URL } from "../../lib/site";

export async function getStaticPaths() {
  const posts = sortPostsNewestFirst(await getCollection("posts"));
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { title, excerpt, category, date, author } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const related = relatedPosts(posts, post.id);
const url = `${SITE_URL}${postUrl(post.id)}`;
const dateLabel = postDateLabel(date);
const minutes = postMinutes(post.body);
const shareUrl = encodeURIComponent(url), shareTitle = encodeURIComponent(title);

function cardProps(p: (typeof posts)[number]) {
  return {
    post: p,
    dateLabel: postDateLabel(p.data.date),
    minutes: postMinutes(p.body),
    numberLabel: String(postNumber(posts, p.id)).padStart(2, "0"),
    coverVariant: postCoverVariant(posts, p.id),
  };
}
---
<Layout
  title={`${title} | Tope Gideon`}
  description={excerpt}
  path={postUrl(post.id)}
  dataPage="blog"
  stickyCta
  ogType="article"
  jsonLd={[
    { "@context": "https://schema.org", "@type": "Article", headline: title, description: excerpt,
      datePublished: date.toISOString().slice(0, 10), dateModified: date.toISOString().slice(0, 10),
      author: { "@type": "Person", name: author, url: `${SITE_URL}/about` },
      publisher: { "@type": "Person", name: "Tope Gideon" }, mainEntityOfPage: url, image: `${SITE_URL}/assets/images/og-image.png` },
    { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog` },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ] },
  ]}
>
<section class="page-hero post-hero" aria-labelledby="pT">
  <div class="page-hero__inner">
    <a class="eyebrow" href="/blog">&larr; All posts</a>
    <h1 class="display page-hero__title rv rv--d1" id="pT">{title}</h1>
    <div class="meta-row rv rv--d2"><span class="cover__cat">{category}</span><span>{dateLabel}</span><span>{minutes} min read</span><span>By {author}</span></div>
  </div>
</section>

<section class="sheet">
  <div class="article">
    <div class="prose rv rv--d2"><Content /></div>
    <aside class="toc rv rv--d3" aria-label="Article tools">
      {toc.length > 0 && (
        <div><p class="toc__title">On this page</p><ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></div>
      )}
      <div><p class="toc__title">Share</p><div class="share">
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener">LinkedIn</a>
        <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`} target="_blank" rel="noopener">X</a>
        <button type="button" id="copyLink" data-url={url}>Copy link</button>
      </div></div>
    </aside>
  </div>
</section>

<section class="related">
  <div class="wrap">
    <div class="section-dark__head related__head"><div class="stack stack--md"><span class="eyebrow rv">Keep reading</span><h2 class="display h2 rv rv--d1">More posts</h2></div><a class="btn btn--ghost btn--sm rv rv--d2" href="/blog">All posts <svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"/></svg></a></div>
    <div class="posts posts--related" id="relatedGrid">
      {related.map((p) => <PostCard {...cardProps(p)} />)}
    </div>
  </div>
</section>
</Layout>
