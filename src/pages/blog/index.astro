---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";
import { sortPostsNewestFirst, postDateLabel, postMinutes, postNumber, postCoverVariant } from "../../lib/content";

const posts = sortPostsNewestFirst(await getCollection("posts"));
const [featured, ...rest] = posts;
const categories = ["All", "SEO", "Performance", "Workflow", "CMS"];

function cardProps(post: (typeof posts)[number]) {
  return {
    post,
    dateLabel: postDateLabel(post.data.date),
    minutes: postMinutes(post.body),
    numberLabel: String(postNumber(posts, post.id)).padStart(2, "0"),
    coverVariant: postCoverVariant(posts, post.id),
  };
}
---
<Layout
  title="Webflow Blog: SEO, CMS &amp; Speed Tips | Tope Gideon"
  description="Practical Webflow tips on speed, SEO, CMS structure and WordPress migrations from Tope Gideon, a Top Rated Webflow developer."
  path="/blog"
  dataPage="blog"
  stickyCta
  jsonLd={[{ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://topegideon.vercel.app/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://topegideon.vercel.app/blog" },
  ] }]}
>
<section class="page-hero" aria-labelledby="pT">
  <div class="page-hero__inner">
    <span class="eyebrow rv">Writing</span>
    <h1 class="display page-hero__title rv rv--d1" id="pT">Blog</h1>
    <p class="lead rv rv--d3">Practical Webflow tips on speed, SEO and CMS.</p>
  </div>
</section>

<div class="wrap posts-wrap">
  <div class="blog-tools">
    <div class="filters" id="blogFilters" role="group" aria-label="Filter posts by category">
      {categories.map((c, i) => <button class="filter" type="button" aria-pressed={i === 0 ? "true" : "false"} data-f={c}>{c}</button>)}
    </div>
    <div class="blog-tools__right">
      <span id="blogCount" class="card__stack" aria-live="polite">{posts.length} posts</span>
      <label class="search"><span class="sr-only">Search posts</span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="m10.5 10.5 3 3"/></svg><input id="blogSearch" type="search" placeholder="Search posts" autocomplete="off"></label>
    </div>
  </div>
  <div id="blogGrid">
    {featured && <PostCard {...cardProps(featured)} featured />}
    <div class="posts">
      {rest.map((post) => <PostCard {...cardProps(post)} />)}
    </div>
    <p class="empty" id="blogEmpty" hidden>No posts match that search. Try another word or clear the filter.</p>
  </div>
</div>
</Layout>
