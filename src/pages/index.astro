---
import Layout from "../layouts/Layout.astro";
import Faq from "../components/Faq.astro";
import ProjectRow from "../components/ProjectRow.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";
import { sortPostsNewestFirst, postDateLabel, postMinutes, postNumber, postCoverVariant } from "../lib/content";
import { UPWORK_URL } from "../lib/site";

const projects = (await getCollection("projects")).slice(0, 5); // data.js order — edit src/content/projects.json to change
const allPosts = sortPostsNewestFirst(await getCollection("posts"));
const latestPosts = allPosts.slice(0, 3);

const jsonLd = [
  {
    "@context": "https://schema.org", "@type": "Person", name: "Tope Gideon", jobTitle: "Webflow Developer & Designer",
    url: "https://topegideon.vercel.app/", image: "https://topegideon.vercel.app/assets/images/tope.webp",
    description: "Top Rated Webflow developer & designer: Figma to Webflow, SEO-safe WordPress migrations, CMS and technical SEO.",
    address: { "@type": "PostalAddress", addressLocality: "Ibadan", addressCountry: "NG" },
    knowsAbout: ["Webflow", "Figma to Webflow", "WordPress to Webflow migration", "Webflow CMS", "Technical SEO", "Memberstack", "Core Web Vitals"],
    sameAs: ["https://www.upwork.com/freelancers/~01ac39886cec06e248", "https://www.linkedin.com/in/tope-oyenpemi-2a3470245", "https://github.com/Giddytwg", "https://x.com/tg_webflow"],
  },
  { "@context": "https://schema.org", "@type": "WebSite", name: "Tope Gideon", url: "https://topegideon.vercel.app/" },
];
---
<Layout
  title="Webflow Developer &amp; Designer | Tope Gideon"
  description="Top Rated Webflow developer &amp; designer. Pixel-perfect Figma to Webflow builds, SEO-safe WordPress migrations, CMS and technical SEO. Open to remote work."
  path="/"
  dataPage="home"
  stickyCta
  jsonLd={jsonLd}
  preloadImage="/assets/images/tope.webp"
>
<section class="hero" aria-labelledby="heroTitle">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__stage">
    <div class="display hero__name" role="img" aria-label="Tope Gideon">
      <span aria-hidden="true"><i>Tope</i></span>
      <span aria-hidden="true"><i>Gideon</i></span>
    </div>
    <div class="hero__media">
      <figure class="hero__portrait">
        <img src="/assets/images/tope.webp" alt="Portrait of Tope Gideon" width="682" height="1024" fetchpriority="high" decoding="async">
      </figure>
      <div class="hero__badge" aria-hidden="true">
        <svg viewBox="0 0 100 100"><defs><path id="circ" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0"/></defs><text><textPath href="#circ" textLength="230">Top Rated • Webflow expert •</textPath></text></svg>
        <b>✦</b>
      </div>
    </div>
  </div>
  <div class="hero__foot">
    <div class="hero__intro">
      <h1 class="display hero__title" id="heroTitle">Webflow developer for SaaS, startups &amp; agencies</h1>
      <p><b>Top Rated</b> on Upwork. I turn Figma designs into fast, SEO-ready sites and move WordPress to Webflow <b>without losing rankings</b>.</p>
      <div class="hero__cta">
        <a class="btn" href="/contact#request">Start a project <svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"/></svg></a>
        <a class="btn btn--ghost" href="/projects">See my work</a>
      </div>
      <ul class="hero__proof" aria-label="Track record">
        <li><span class="stars" aria-hidden="true">★★★★★</span> 5.0 from 7 rated Upwork jobs</li>
        <li>100% Job Success</li>
        <li class="hero__alt">Prefer Upwork? <a href={UPWORK_URL} target="_blank" rel="noopener">Hire me there</a></li>
      </ul>
    </div>
    <div class="status"><i aria-hidden="true"></i>Open to offers &middot; Contract-to-hire welcome</div>
  </div>
</section>

<section class="sheet sheet--first" id="intro" aria-labelledby="introT">
  <a class="sheet__notch" href="#intro" aria-label="Scroll to content"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5v11M3.5 9 8 13.5 12.5 9"/></svg></a>
  <div class="intro">
    <div class="stack stack--lg">
      <span class="eyebrow rv">Selected work</span>
      <h2 class="display h2 rv rv--d1" id="introT">Fast sites that rank and convert.</h2>
    </div>
    <div class="intro__stats rv rv--d3">
      <div class="stat"><b><span data-count="4">4</span><sup>+</sup></b><span>Years in web design &amp; dev</span></div>
      <div class="stat"><b><span data-count="40">40</span><sup>+</sup></b><span>Projects delivered</span></div>
      <div class="stat"><b><span data-count="100">100</span><sup>%</sup></b><span>Job Success on Upwork</span></div>
    </div>
  </div>
  <div class="list-head">
    <h3 class="display h3">Recent projects</h3>
    <a class="btn btn--dark btn--sm" href="/projects">View all projects <svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"/></svg></a>
  </div>
  <div class="rows" id="rows">
    {projects.map((p, i) => <ProjectRow project={p} n={String(i + 1).padStart(2, "0")} />)}
  </div>
</section>

<div class="marquee" role="presentation"><div class="marquee__track" aria-hidden="true"><span class="marquee__item">Figma to Webflow</span><span class="marquee__item">Client-First</span><span class="marquee__item">Webflow CMS</span><span class="marquee__item">Technical SEO</span><span class="marquee__item">WordPress migration</span><span class="marquee__item">Core Web Vitals</span><span class="marquee__item">Memberstack</span><span class="marquee__item">Zapier</span><span class="marquee__item">Make</span><span class="marquee__item">Airtable</span><span class="marquee__item">GoHighLevel</span><span class="marquee__item">Custom code</span><span class="marquee__item">Figma to Webflow</span><span class="marquee__item">Client-First</span><span class="marquee__item">Webflow CMS</span><span class="marquee__item">Technical SEO</span><span class="marquee__item">WordPress migration</span><span class="marquee__item">Core Web Vitals</span><span class="marquee__item">Memberstack</span><span class="marquee__item">Zapier</span><span class="marquee__item">Make</span><span class="marquee__item">Airtable</span><span class="marquee__item">GoHighLevel</span><span class="marquee__item">Custom code</span></div></div>

<section class="sheet" id="services-sec" aria-labelledby="svcT">
  <div class="split">
    <div class="split__side">
      <span class="eyebrow rv">My services</span>
      <h2 class="display h2 rv rv--d1" id="svcT">What I do</h2>
      <p class="lead rv rv--d2">From Figma builds to full migrations, planned and handed over cleanly.</p>
      <div class="rv rv--d3"><a class="btn btn--dark" href="/contact#request">Start a project <svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"/></svg></a></div>
    </div>
    <div class="svc" id="services">
      <div class="svc__item rv rv--d0"><span class="row__n">01</span><h3 class="display h3">Figma to Webflow</h3><p>Pixel-perfect, fully responsive Webflow builds from your Figma designs or an HTML/CSS reference, with a clean Client-First structure that's easy to hand over.</p></div>
      <div class="svc__item rv rv--d1"><span class="row__n">02</span><h3 class="display h3">Websites &amp; landing pages</h3><p>Full website design and development, high-converting landing pages for SaaS and lead generation, and redesigns that improve UX and conversion.</p></div>
      <div class="svc__item rv rv--d2"><span class="row__n">03</span><h3 class="display h3">Webflow CMS</h3><p>Structured collections, filtering and dynamic pages set up around how your team publishes, so content updates never need a developer.</p></div>
      <div class="svc__item rv rv--d3"><span class="row__n">04</span><h3 class="display h3">WordPress to Webflow migration</h3><p>SEO-safe migrations with 301 redirects, preserved metadata and clean URLs, so you move platforms without losing rankings or traffic.</p></div>
      <div class="svc__item rv rv--d4"><span class="row__n">05</span><h3 class="display h3">Technical SEO &amp; speed</h3><p>Meta and heading structure, schema/JSON-LD, sitemaps, Core Web Vitals and page-speed work, plus GA4 and Google Search Console tracking.</p></div>
      <div class="svc__item rv rv--d0"><span class="row__n">06</span><h3 class="display h3">Memberships &amp; automation</h3><p>Memberstack portals, multi-step forms and booking flows, custom JavaScript, API and payment integrations, and Zapier, Make and Airtable workflows with CRM setup (GoHighLevel, ActiveCampaign, Klaviyo).</p></div>
    </div>
  </div>
  <div class="packages">
    <div class="list-head list-head--packages">
      <h3 class="display h3 rv" id="pkgT">Fixed-price starters</h3>
      <span class="list-head__note rv rv--d1">Also available on my Upwork Project Catalog</span>
    </div>
    <div class="packages__grid">
      <div class="pkg rv rv--d0">
        <div><span class="pkg__price">From $150</span><span class="pkg__time">2 days delivery</span></div>
        <h4 class="display h3">Figma to Webflow</h4><p>Convert your Figma design to a pixel-perfect responsive Webflow website.</p>
        <div class="pkg__actions">
          <a class="btn btn--sm" href="/contact?need=Figma#request">Get started <svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"/></svg></a>
          <a class="pkg__alt" href={UPWORK_URL} target="_blank" rel="noopener">or order on Upwork</a>
        </div>
      </div>
      <div class="pkg rv rv--d2">
        <div><span class="pkg__price">From $400</span><span class="pkg__time">5 days delivery</span></div>
        <h4 class="display h3">WordPress to Webflow</h4><p>Migrate your WordPress site to Webflow with 301 redirects, CMS and no lost SEO.</p>
        <div class="pkg__actions">
          <a class="btn btn--sm" href="/contact?need=WordPress#request">Get started <svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"/></svg></a>
          <a class="pkg__alt" href={UPWORK_URL} target="_blank" rel="noopener">or order on Upwork</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-dark" aria-labelledby="toolsT">
  <div class="section-dark__head">
    <div class="stack stack--md"><span class="eyebrow rv">My toolkit</span><h2 class="display h2 rv rv--d1" id="toolsT">Tools I use</h2></div>
    <p class="lead rv rv--d2">The platforms I build and automate with.</p>
  </div>
  <div class="tools__grid">
    <article class="tool rv rv--d0">
      <div class="tool__logo" aria-hidden="true"><img src="/assets/logos/webflow.svg" alt="" width="34" height="34" loading="lazy" decoding="async"></div>
      <h3>Webflow</h3><p>My main build tool: design, CMS, interactions and hosting.</p>
    </article>
    <article class="tool rv rv--d1">
      <div class="tool__logo" aria-hidden="true"><img src="/assets/logos/memberstack.svg" alt="" width="34" height="34" loading="lazy" decoding="async"></div>
      <h3>Memberstack</h3><p>Logins, memberships and gated content on Webflow sites.</p>
    </article>
    <article class="tool rv rv--d2">
      <div class="tool__logo" aria-hidden="true"><img src="/assets/logos/zapier.svg" alt="" width="34" height="34" loading="lazy" decoding="async"></div>
      <h3>Zapier</h3><p>Connects forms, CRMs and email so leads flow without copy-paste.</p>
    </article>
    <article class="tool rv rv--d0">
      <div class="tool__logo" aria-hidden="true"><img src="/assets/logos/gohighlevel.png" alt="" width="34" height="34" loading="lazy" decoding="async"></div>
      <h3>GoHighLevel</h3><p>CRM, funnels and follow-up automations connected to your site.</p>
    </article>
    <article class="tool rv rv--d1">
      <div class="tool__logo" aria-hidden="true"><img src="/assets/logos/custom-code.svg" alt="" width="34" height="34" loading="lazy" decoding="async"></div>
      <h3>Custom code</h3><p>HTML, CSS and JavaScript, APIs and payment integrations when no-code can't do it.</p>
    </article>
    <article class="tool rv rv--d2">
      <div class="tool__logo" aria-hidden="true"><img src="/assets/logos/react.svg" alt="" width="34" height="34" loading="lazy" decoding="async"></div>
      <h3>React</h3><p>Custom front-ends when a project needs app-like behavior.</p>
    </article>
    <article class="tool rv rv--d0">
      <div class="tool__logo" aria-hidden="true"><img src="/assets/logos/wordpress.svg" alt="" width="34" height="34" loading="lazy" decoding="async"></div>
      <h3>WordPress</h3><p>Migrating existing WordPress sites to Webflow without losing rankings.</p>
    </article>
    <article class="tool rv rv--d1">
      <div class="tool__logo" aria-hidden="true"><img src="/assets/logos/astro.svg" alt="" width="34" height="34" loading="lazy" decoding="async"></div>
      <h3>Astro</h3><p>Fast, content-driven sites and static builds when a project calls for real code.</p>
    </article>
  </div>
  <ul class="tools__more" aria-label="More tools"><li class="tools__label">Also</li><li class="tool-chip"><span aria-hidden="true"><img src="/assets/logos/figma.svg" alt="" width="18" height="18" loading="lazy" decoding="async"></span>Figma</li><li class="tool-chip"><span aria-hidden="true">FC</span>Finsweet Client-First &amp; Attributes</li><li class="tool-chip"><span aria-hidden="true"><img src="/assets/logos/make.svg" alt="" width="18" height="18" loading="lazy" decoding="async"></span>Make</li><li class="tool-chip"><span aria-hidden="true"><img src="/assets/logos/airtable.svg" alt="" width="18" height="18" loading="lazy" decoding="async"></span>Airtable</li><li class="tool-chip"><span aria-hidden="true"><img src="/assets/logos/ga4.svg" alt="" width="18" height="18" loading="lazy" decoding="async"></span>GA4</li><li class="tool-chip"><span aria-hidden="true"><img src="/assets/logos/gsc.svg" alt="" width="18" height="18" loading="lazy" decoding="async"></span>Search Console</li><li class="tool-chip"><span aria-hidden="true"><img src="/assets/logos/typescript.svg" alt="" width="18" height="18" loading="lazy" decoding="async"></span>TypeScript</li><li class="tool-chip"><span aria-hidden="true"><img src="/assets/logos/tailwind.svg" alt="" width="18" height="18" loading="lazy" decoding="async"></span>Tailwind CSS</li><li class="tool-chip"><span aria-hidden="true"><img src="/assets/logos/github.svg" alt="" width="18" height="18" loading="lazy" decoding="async"></span>GitHub</li><li class="tool-chip"><span aria-hidden="true"><img src="/assets/logos/vercel.svg" alt="" width="18" height="18" loading="lazy" decoding="async"></span>Vercel</li></ul>
</section>

<section class="sheet" id="quotes" aria-labelledby="qT">
  <div class="quotes__head">
    <div><span class="eyebrow rv">Kind words</span><h2 class="display h2 rv rv--d1" id="qT">What clients say</h2></div>
    <div class="quotes__nav">
      <button type="button" data-dir="-1" aria-label="Previous review"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4"/></svg></button>
      <button type="button" data-dir="1" aria-label="Next review"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></button>
    </div>
  </div>
  <ul class="quotes__proof" aria-label="Upwork track record"><li class="proof__badge">Top Rated</li><li class="proof__badge">100% Job Success</li></ul>

  <div class="quotes__rail" tabindex="0" aria-label="Client reviews">
    <figure class="quote rv" data-src="upwork">
      <div class="quote__top"><span class="stars" role="img" aria-label="5 out of 5 stars">★★★★★</span></div>
      <blockquote><input class="quote__check" type="checkbox" id="rm-0" aria-label="Show the full review">
        <p class="quote__clamp">&ldquo;My experience with Tope was excellent overall. Toape developed my corporate website and made the whole process easy. Tope's communication was clear and consistent from start to finish. He understood the vision quickly and translated it with little back and forth. When problems came up, he solved them proactively rather than flagging them and waiting. He went beyond the brief several times and demonstrated why his value accordingly. Five stars, and I will hire him again.&rdquo;</p>
        <label class="quote__more" for="rm-0"><span class="quote__more-open">Read more</span><span class="quote__more-close">Show less</span></label>
      </blockquote>
      <div class="quote__did"><b>Project</b><span>Webflow Website Build — Consulting Firm (Multi-Page, CMS, SEO Ready)</span><ul class="quote__tools" aria-label="Tools used"><li><span aria-hidden="true"><img src="/assets/logos/webflow.svg" alt="" width="14" height="14" loading="lazy" decoding="async"></span>Webflow</li></ul></div>
      <figcaption><span class="avatar" aria-hidden="true">U</span><cite><b>Upwork client</b></cite><a class="quote__link" href={UPWORK_URL} target="_blank" rel="noopener" aria-label="View the original review"><svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"/></svg></a></figcaption>
    </figure>
    <figure class="quote rv" data-src="upwork">
      <div class="quote__top"><span class="stars" role="img" aria-label="5 out of 5 stars">★★★★★</span></div>
      <blockquote><input class="quote__check" type="checkbox" id="rm-1" aria-label="Show the full review">
        <p class="quote__clamp">&ldquo;Tope did an excellent job delivering exactly what we needed, under tight time constraints. The scope was to clone an existing landing page and implement a multi-step quiz UI in Webflow within 24–48 hours, and he executed flawlessly. He followed instructions precisely, stayed focused on replication (no unnecessary deviations), and delivered a clean, fully editable Webflow project. The structure and class naming were organized and easy to work with, which made post-delivery iteration seamless. The quiz flow worked smoothly, including the transitions and logic, and he handled the technical constraints well without overcomplicating the build. Communication was clear and efficient throughout. He asked the right questions upfront, required minimal back-and-forth, and hit the deadline without issues. If you need someone who can move fast, follow direction, and deliver a solid Webflow build without drama, Tope is a great choice. Would definitely work with him again.&rdquo;</p>
        <label class="quote__more" for="rm-1"><span class="quote__more-open">Read more</span><span class="quote__more-close">Show less</span></label>
      </blockquote>
      <div class="quote__did"><b>Project</b><span>Clone a landing page + multi-step quiz UI in Webflow in 24–48 hours</span><ul class="quote__tools" aria-label="Tools used"><li><span aria-hidden="true"><img src="/assets/logos/webflow.svg" alt="" width="14" height="14" loading="lazy" decoding="async"></span>Webflow</li></ul></div>
      <figcaption><span class="avatar" aria-hidden="true">U</span><cite><b>Upwork client</b></cite><a class="quote__link" href={UPWORK_URL} target="_blank" rel="noopener" aria-label="View the original review"><svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"/></svg></a></figcaption>
    </figure>
    <figure class="quote rv" data-src="upwork">
      <div class="quote__top"><span class="stars" role="img" aria-label="5 out of 5 stars">★★★★★</span></div>
      <blockquote>
        <p class="quote__clamp">&ldquo;Tope was fast, efficient, and communicated clearly from start to finish. I provided a mockup and he translated it into Webflow quickly and accurately. Revisions were turned around fast, and the final build matched what I envisioned. Highly recommend.&rdquo;</p>
      </blockquote>
      <div class="quote__did"><b>Project</b><span>Webflow website creation from a mockup</span><ul class="quote__tools" aria-label="Tools used"><li><span aria-hidden="true"><img src="/assets/logos/webflow.svg" alt="" width="14" height="14" loading="lazy" decoding="async"></span>Webflow</li></ul></div>
      <figcaption><span class="avatar" aria-hidden="true">U</span><cite><b>Upwork client</b></cite><a class="quote__link" href={UPWORK_URL} target="_blank" rel="noopener" aria-label="View the original review"><svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"/></svg></a></figcaption>
    </figure>
    <figure class="quote rv" data-src="upwork">
      <div class="quote__top"><span class="stars" role="img" aria-label="5 out of 5 stars">★★★★★</span></div>
      <blockquote>
        <p class="quote__clamp">&ldquo;It was my first time using Upwork and Tope successfully built the website I needed on Webflow. He's a clear communicator, problem-solved where needed, and worked efficiently.&rdquo;</p>
      </blockquote>
      <div class="quote__did"><b>Project</b><span>Extremely simple Webflow site</span><ul class="quote__tools" aria-label="Tools used"><li><span aria-hidden="true"><img src="/assets/logos/webflow.svg" alt="" width="14" height="14" loading="lazy" decoding="async"></span>Webflow</li></ul></div>
      <figcaption><span class="avatar" aria-hidden="true">U</span><cite><b>Upwork client</b></cite><a class="quote__link" href={UPWORK_URL} target="_blank" rel="noopener" aria-label="View the original review"><svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"/></svg></a></figcaption>
    </figure>
    <figure class="quote rv" data-src="upwork">
      <div class="quote__top"><span class="stars" role="img" aria-label="5 out of 5 stars">★★★★★</span></div>
      <blockquote>
        <p class="quote__clamp">&ldquo;Tope was very easy to work with, handled things quickly and communicated well&rdquo;</p>
      </blockquote>
      <div class="quote__did"><b>Project</b><span>Webflow development</span><ul class="quote__tools" aria-label="Tools used"><li><span aria-hidden="true"><img src="/assets/logos/webflow.svg" alt="" width="14" height="14" loading="lazy" decoding="async"></span>Webflow</li></ul></div>
      <figcaption><span class="avatar" aria-hidden="true">U</span><cite><b>Upwork client</b></cite><a class="quote__link" href={UPWORK_URL} target="_blank" rel="noopener" aria-label="View the original review"><svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"/></svg></a></figcaption>
    </figure>
    <figure class="quote rv" data-src="upwork">
      <div class="quote__top"><span class="stars" role="img" aria-label="5 out of 5 stars">★★★★★</span></div>
      <blockquote>
        <p class="quote__clamp">&ldquo;It was a pleasure to work with Tope. Great professional, always trying to accommodate my needs. Looking forward to work again in the future!&rdquo;</p>
