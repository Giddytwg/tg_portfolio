---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="Page not found | Tope Gideon"
  description="That page does not exist or has moved. Head back to the home page, my projects or the project request form."
  path="/404"
  dataPage="404"
  noindex
>
<section class="page-hero" aria-labelledby="pT">
  <div class="page-hero__inner">
    <span class="eyebrow rv">Error 404</span>
    <h1 class="display page-hero__title rv rv--d1" id="pT">Page not found</h1>
    <div class="page-hero__row rv rv--d3"><p class="lead">That page doesn't exist or has moved. Here are the most useful places to go next.</p><div class="page-hero__actions"><a class="btn" href="/">Back to home</a><a class="btn btn--ghost" href="/projects">See my work</a><a class="btn btn--ghost" href="/contact#request">Start a project</a></div></div>
  </div>
</section>
</Layout>
