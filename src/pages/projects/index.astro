---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---
<Layout
  title="Webflow &amp; React Projects | Tope Gideon"
  description="Selected Webflow and React projects: hospitality, real estate, crypto, healthcare, agency and e-commerce sites built by Tope Gideon."
  path="/projects"
  dataPage="projects"
  stickyCta
  jsonLd={[{ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://topegideon.vercel.app/" },
    { "@type": "ListItem", position: 2, name: "Projects", item: "https://topegideon.vercel.app/projects" },
  ] }]}
>
<section class="page-hero" aria-labelledby="pT">
  <div class="page-hero__inner">
    <span class="eyebrow rv">Selected work</span>
    <h1 class="display page-hero__title rv rv--d1" id="pT">Projects</h1>
    <div class="page-hero__row rv rv--d3">
      <p class="lead">Live sites I've built. Open any project for details.</p>
      <div class="filters-block">
        <div class="filters" id="filters" role="group" aria-label="Filter projects by type">
          <button class="filter" type="button" aria-pressed="true" data-f="All">All</button>
          <button class="filter" type="button" aria-pressed="false" data-f="Webflow">Webflow</button>
          <button class="filter" type="button" aria-pressed="false" data-f="React">React</button>
        </div>
        <span id="count" class="card__stack" aria-live="polite">{projects.length} projects</span>
      </div>
    </div>
  </div>
</section>

<div class="wrap"><div class="grid" id="grid">
  {projects.map((project) => <ProjectCard project={project} />)}
</div></div>
</Layout>
